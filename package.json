{
  "name": "eduviz",
  "version": "0.1.0",
  "description": "Universal Educational Visualization Engine",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint --no-error-on-unmatched-pattern *.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'dist/**/*.test.js'",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "education",
    "visualization",
    "interactive",
    "learning"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "typescript": "^7.0.2"
  }
}
